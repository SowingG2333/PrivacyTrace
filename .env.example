# Shared OpenAI-compatible model endpoint
MY_MODEL_BASE_URL=https://api.example.com/v1
MY_MODEL_API_KEY=replace-with-your-api-key
# Optional comma-separated additional keys for concurrent Profile generation
MY_MODEL_API_KEYS=
# Optional per-key rolling RPM limits, ordered as primary key then additional keys
MY_MODEL_API_KEY_RPMS=
MY_MODEL_API_KEY_CONCURRENCIES=
MY_MODEL_PROVIDER_HEALTH_MODE=gate
MY_MODEL_API_KEY_AUDIT_BATCH_SIZES=
MY_MODEL_API_KEY_COMPLETION_BATCH_SIZES=
MY_MODEL_NAME=your-model-name

# Optional Profile PII generation model using selected keys from the audit pool.
# In rpm mode, PROFILE_GENERATION_CONCURRENCY is only the global maximum number
# of in-flight/waiting transports. Per-key selection and request cadence come
# from MY_MODEL_API_KEY_RPMS and are evenly spaced across each minute.
PROFILE_GENERATION_MODEL=your-profile-generation-model
PROFILE_GENERATION_KEY_SOURCE=audit_pool
PROFILE_GENERATION_SCHEDULER=rpm
PROFILE_GENERATION_KEY_INDEXES=1,2
PROFILE_GENERATION_KEY_BATCH_SIZES=5,5
PROFILE_GENERATION_CONCURRENCY=20

# Optional independent endpoints; the current 1k run still requires glm-5.2
# SIMULATOR_MODEL_BASE_URL=https://example.com/v1
# SIMULATOR_MODEL_API_KEY=...
# SIMULATOR_MODEL_NAME=glm-5.2

# Optional independent evaluated-agent model
# AGENT_MODEL_BASE_URL=https://example.com/v1
# AGENT_MODEL_API_KEY=...
# AGENT_MODEL_NAME=glm-5.2

# MCP server credentials (only configure the servers you enable)
GEOAPIFY_API_KEY=YOUR_GEOAPIFY_API_KEY
NPS_API_KEY=YOUR_NPS_API_KEY
WEATHER_API_KEY=YOUR_WEATHER_API_KEY
TMDB_API_KEY=YOUR_TMDB_API_KEY
NCI_API_KEY=YOUR_NCI_API_KEY
HF_TOKEN=YOUR_HF_TOKEN
NASA_API_KEY=YOUR_NASA_API_KEY
DUFFEL_ACCESS_TOKEN=YOUR_DUFFEL_TEST_OR_LIVE_ACCESS_TOKEN
# DUFFEL_BASE_URL=https://api.duffel.com
