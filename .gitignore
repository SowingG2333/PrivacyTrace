# Release archives are ignored everywhere except the LFS-backed review folder.
*.tar.gz
*.jsonl.gz
SHA256SUMS.local
!release_assets/
!release_assets/*.tar.gz
!release_assets/*.jsonl.gz

# Private release-audit inputs must never enter the anonymous repository.
identity_patterns.private.*
redactions.private.*
PRIVATE_RELEASE_AUDIT*

# Generated MCP catalog diagnostics
