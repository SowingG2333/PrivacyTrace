# MCP Server Framework Configuration

# Main MCP Server Port
MCP_SERVER_PORT=3000

# Geoapify API Key (required for maps tools)
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Optional Geoapify settings
GEOAPIFY_LANGUAGE=zh
# GEOAPIFY_TIMEOUT_MS=15000
# GEOAPIFY_API_BASE_URL=https://api.geoapify.com

# Add your custom server ports here
# YOUR_CUSTOM_SERVER_PORT=3001
