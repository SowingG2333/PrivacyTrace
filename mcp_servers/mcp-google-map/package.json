{
  "name": "@anonymous-review/mcp-geoapify",
  "version": "0.1.0",
  "description": "Geoapify MCP server with streamable HTTP transport for places, geocoding, routing, matrices, and elevation",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-geoapify": "dist/cli.js",
    "mcp-google-map": "dist/cli.js"
  },
  "files": [
    "dist",
    "dist/**/*.map",
    "README.md"
  ],
  "scripts": {
    "build": "tsup --dts",
    "test": "tsx --test test/**/*.test.ts",
    "start": "node dist/cli.js",
    "dev": "cross-env NODE_ENV=development tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "geoapify",
    "openstreetmap",
    "map",
    "api",
    "llm",
    "typescript",
    "mcp",
    "server",
    "streamable",
    "location",
    "geocoding",
    "navigation"
  ],
  "author": "Anonymous review snapshot",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "@types/yargs": "^17.0.33",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "yargs": "^17.7.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.17.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.5.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
